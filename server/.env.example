# Required for server startup
MONGO_URI=mongodb://127.0.0.1:27017/homieplace
NODE_ENV=development

# Required for login and authenticated profile requests; use a long random secret
JWT_SECRET=

# Required for registration and password-reset email delivery (Gmail app password)
SMTP_USER=
SMTP_PASS=

# Required for password-reset links; use an HTTPS origin in production
CLIENT_URL=http://localhost:5173

# Required for avatar uploads
CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=
