{
  "name": "homieplace",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  },
  "devDependencies": {
    "@types/streamifier": "^0.1.2",
    "concurrently": "^10.0.5"
  }
}
